[layer_names]

3d_physics/layer_1="Welt"
3d_physics/layer_2="Auto"

[physics]

; Jolt ist in Godot 4.6 die Voreinstellung für neue 3D-Projekte.
3d/physics_engine="Jolt Physics"
; Der Fahrzeug-Controller verlangt mindestens 120. Ändern verändert das Fahrverhalten.
common/physics_ticks_per_second=120
; TUNING-PARAMETER 0 — Schwerkraft. Godot-Standard ist 9.8.
; Hier bewusst Faktor 2 (Spielzeug-Look: kurze, schnappige Sprünge).
; Das ist eine offene Frage, kein belegter Wert. Siehe TUNING.md, Abschnitt "Kopplungen".
3d/default_gravity=19.62

[rendering]

anti_aliasing/quality/msaa_3d=2
rendering_device/driver.windows="d3d12"
