[gd_scene load_steps=11 format=3]

; ---------------------------------------------------------------------------
; Spielzeugauto — Slice 0 / Slice 1
;
; MASSSTAB: Das Auto ist 4 Godot-Einheiten lang. Die Welt wird mit Faktor ~57
; gegenüber der Realität gebaut (1 Realzentimeter ~ 0,57 Einheiten). Nicht das
; Auto verkleinern — Kollisionstoleranz, Federweg und Solver-Schritt sind bei
; sehr kleinen Körpern größer als das Fahrzeug. Siehe CONTEXT.md.
;
; KAROSSERIE: Kenney Toy Car Kit, "vehicle-truck" (CC0, siehe ASSETS.md).
; Gewählt, weil der flache Kastenaufbau die sichtbaren Anbauteile ab Slice 1
; trägt — Rammbock vorn, später Rotor und Greifer. Eine Rennwagensilhouette
; trägt sie nicht.
;
; Rohlänge des Modells 0,8625 -> Skalierung 4/0,8625 = 4,637681 ergibt genau
; 4 Einheiten. Der Karosserieknoten sitzt bei y = -0,067, damit die Radaufstands-
; ebene des Modells (dort liegt sein y = 0) auf dem Boden liegt, wenn das Auto
; in Ruhe steht. Gemessene Ruhehöhe des Wurzelknotens: y = 0,067.
;
; Die vier Räder des Modells hängen im GLB UNTER dem Karosserie-Mesh und sind
; hier auf visible = false gesetzt. Sie sind starr; die sichtbaren Räder müssen
; an den Naben hängen, weil wheel.gd dort Federung und Lenkeinschlag anzeigt.
; Dafür ist der Knoten als "editable" markiert.
;
;   Diese Überschreibungen hängen an "index=" und damit an der Reihenfolge, in
;   der der Importer die Kinder anlegt. Gegen einen Kaltimport geprüft (.godot/
;   gelöscht, neu importiert): Reihenfolge und alle vier visible = false halten.
;   Falls nach einem Godot-Update doch ein starres Rad auftaucht, ist das die
;   Stelle — dann statt der Szenen-Überschreibung den Knoten schon beim Import
;   überspringen (vehicle-truck.glb.import, _subresources/nodes).
;
; RÄDER: "wheel-small" aus demselben Kit — das Modell, das der Truck selbst
; benutzt. Rohradius 0,125, skaliert mit 3,6 auf Radius 0,45.
;
;   ACHTUNG, bewusst in Kauf genommene Abweichung: Das Modell will eigentlich
;   Radius 0,58 (seine eigenen Räder, mit 4,637681 skaliert). Getunt ist aber
;   0,45, und der Reifenradius hängt über TUNING.md (Kopplung 3) am
;   Motordrehmoment. Deshalb bleibt die Physik unangetastet und das Rad wird
;   optisch auf 0,45 gebracht — der Truck sieht dadurch etwas untergerädert
;   aus. Wer das ändern will, ändert Fahrverhalten, nicht Optik.
;
;   Ebenso: Modell-Spurweite 1,74 und Radstand 2,32 gegen 1,60 / 2,20 im
;   Projekt. Die Räder sitzen also minimal weiter innen als die Radkästen.
;
; KOLLISIONSKÖRPER unverändert (1,9 x 1,35 x 3,9). Die sichtbare Karosserie ist
; breiter (2,44) und höher (2,43) als dieser Kasten. Das ist Absicht: den Kasten
; zu ändern ändert das Fahrgefühl, und Slice 0 ist bestanden und eingefroren.
;
; FAHRHILFEN: alle aus. Siehe TUNING.md.
; ---------------------------------------------------------------------------

[ext_resource type="Script" path="res://addons/gevp/scripts/vehicle.gd" id="1_fahrzeug"]
[ext_resource type="Script" path="res://addons/gevp/scripts/wheel.gd" id="2_rad"]
[ext_resource type="PackedScene" path="res://kamera/kamerarig.tscn" id="3_kamera"]
[ext_resource type="PackedScene" path="res://addons/gevp/scenes/engine_sound.tscn" id="4_motorton"]
[ext_resource type="PackedScene" path="res://fremd/kenney_toy_car_kit/vehicle-truck.glb" id="5_karosserie"]
[ext_resource type="PackedScene" path="res://fremd/kenney_toy_car_kit/wheel-small.glb" id="6_rad_modell"]
[ext_resource type="PackedScene" path="res://auto/rammbock.tscn" id="7_rammbock"]
[ext_resource type="Script" path="res://auto/rammbock_wirkung.gd" id="8_wirkung"]

; Drehmomentkurve des Arcade-Presets, unverändert übernommen.
[sub_resource type="Curve" id="Curve_drehmoment"]
_data = [Vector2(0, 0.494505), 0.0, 2.04495, 0, 0, Vector2(0.617978, 1), 0.0, 0.0, 0, 0, Vector2(1, 0.692308), -1.4839, 0.0, 0, 0]
point_count = 3

[sub_resource type="BoxShape3D" id="BoxShape3D_karosserie"]
size = Vector3(1.9, 1.35, 3.9)

; --- Rammbock (Slice 1) --------------------------------------------------
; Die Geometrie steht in auto/rammbock.tscn, weil das Fundstück dieselbe
; benutzt. Hier nur die Kollisionsform, die genau den Balken abdeckt.
[sub_resource type="BoxShape3D" id="BoxShape3D_rammbock"]
size = Vector3(2.2, 0.55, 0.35)

; Auslösebereich für den Zerfall. Etwas größer als der Balken, damit ein
; Streifschuss zählt.
[sub_resource type="BoxShape3D" id="BoxShape3D_wirkung"]
size = Vector3(2.4, 0.9, 0.6)

[node name="Spielzeugauto" type="RigidBody3D" node_paths=PackedStringArray("front_left_wheel", "front_right_wheel", "rear_left_wheel", "rear_right_wheel")]
collision_layer = 2
collision_mask = 1
center_of_mass_mode = 1
linear_damp_mode = 1
angular_damp_mode = 1
script = ExtResource("1_fahrzeug")

; --- Räder --------------------------------------------------------------
front_left_wheel = NodePath("RadVorneLinks")
front_right_wheel = NodePath("RadVorneRechts")
rear_left_wheel = NodePath("RadHintenLinks")
rear_right_wheel = NodePath("RadHintenRechts")

; --- Fahrhilfen: alle aus (Slice 0, Woche 6-8) ---------------------------
; Sonst tunt man gegen versteckte Korrekturen. Einzeln zuschalten kommt NACH
; dem Grundtuning. Wie man sie wieder anschaltet, steht in TUNING.md.
steering_slip_assist = 100000.0
countersteer_assist = 0.0
traction_control_max_slip = -1.0
front_abs_spin_difference_threshold = 100000.0
rear_abs_spin_difference_threshold = 100000.0
enable_stability = false

; --- Motor / Antrieb (Arcade-Preset) -------------------------------------
; max_torque gegenüber dem Arcade-Preset (300) hochgezogen, weil der größere
; Reifenradius (0,45 statt 0,3) dasselbe Drehmoment in weniger Vortrieb umsetzt.
max_torque = 450.0
torque_curve = SubResource("Curve_drehmoment")
variable_torque_split = true
front_variable_split = 0.5

; --- Bremsen -------------------------------------------------------------
; Der Controller rechnet die Bremskraft intern mit fest verdrahteten 9,8 m/s².
; Bei Schwerkraft x2 haben die Reifen doppelte Radlast, die Bremse aber nicht
; mehr Kraft. Deshalb hier x2. Ändert sich die Schwerkraft, ändert sich das mit.
brake_force_multiplier = 2.0
braking_grip_multiplier = 2.0

; --- Masse und Federung --------------------------------------------------
; ACHTUNG Kopplung: die Federrate wird aus Masse, Federweg und Ruhelage
; berechnet — ebenfalls mit fest verdrahteten 9,8 m/s². Faustregel:
;   resting_ratio = 0,5 / Schwerkraftfaktor
; Bei Faktor 2 also 0,25. Wer die Schwerkraft ändert und das hier vergisst,
; setzt das Auto auf die Anschläge und tunt danach Unsinn. Siehe TUNING.md.
vehicle_mass = 1500.0
center_of_gravity_height_offset = -0.35
front_spring_length = 0.25
front_resting_ratio = 0.25
front_damping_ratio = 0.6
rear_spring_length = 0.3
rear_resting_ratio = 0.25
rear_damping_ratio = 0.6

; --- Reifen --------------------------------------------------------------
contact_patch = 0.3
lateral_grip_assist = {
"Dirt": 0.0,
"Grass": 0.0,
"Road": 0.0
}
front_tire_radius = 0.45
front_tire_width = 320.0
front_wheel_mass = 25.0
rear_tire_radius = 0.45
rear_tire_width = 320.0
rear_wheel_mass = 25.0

[node name="Kollision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.1, 0)
shape = SubResource("BoxShape3D_karosserie")

; --- Karosserie: Kenney "vehicle-truck", auf 4 Einheiten Länge skaliert ---
[node name="Karosserie" parent="." instance=ExtResource("5_karosserie")]
transform = Transform3D(4.637681, 0, 0, 0, 4.637681, 0, 0, 0, 4.637681, 0, -0.067, 0)

; Die modelleigenen Räder sind starr und würden die echten doppeln.
[node name="wheel-bl" parent="Karosserie/vehicle-truck" index="0"]
visible = false

[node name="wheel-fr" parent="Karosserie/vehicle-truck" index="1"]
visible = false

[node name="wheel-fl" parent="Karosserie/vehicle-truck" index="2"]
visible = false

[node name="wheel-br" parent="Karosserie/vehicle-truck" index="3"]
visible = false

; --- Rammbock: Slice 1, Block 2 ------------------------------------------
; Sitzt AUSSEN am Auto. Keine Zeile im fremden Controller — das ist die Regel
; aus CLAUDE.md, und sie ist der Grund für diesen Aufbau.
;
; Startzustand: "Rammbock" unsichtbar, "RammbockKollision" disabled,
; "RammbockWirkung" nicht überwachend. welt/fundstueck.gd schaltet alle drei
; beim Aufsammeln an — an EINER Stelle, damit das Teil nicht halb an sein kann. Das ist der ganze "Einbau" — kein Slot, kein Inventar.
; Bei genau einem Teil ist jede Verwaltung Selbstzweck (SLICE1.md).
;
; Die Vorderkante der Karosserie liegt bei z = -2,0. Der Balken sitzt bei -2,18
; und ragt damit knapp 0,23 vor den Kollisionskasten (Vorderkante -1,95).
;
; ACHTUNG: Die zusätzliche CollisionShape3D verändert den Trägheitstensor des
; RigidBody3D, auch ohne eigene Masse — Godot rechnet die Trägheit aus den
; Formen. Deshalb ist sie im Ruhezustand disabled, und deshalb ist "die Masse
; des Rammbocks auf 0 setzen" (SLICE1.md, Risikozeile) nicht die ganze Miete.
; Gemessen ist beides: siehe Commit.
; Sichtbarkeit wird am Elternknoten geschaltet — visible vererbt sich nach unten.
[node name="Rammbock" parent="." instance=ExtResource("7_rammbock")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, -2.18)
visible = false

; DIREKTES Kind des RigidBody3D, nicht unter "Rammbock". Godot registriert nur
; CollisionShape3D, die unmittelbar unter dem CollisionObject3D hängen — unter
; einem Node3D verschachtelt wird die Form stillschweigend ignoriert. Geprüft:
; body_get_shape_count() lieferte in der verschachtelten Fassung 1 statt 2.
[node name="RammbockKollision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, -2.18)
shape = SubResource("BoxShape3D_rammbock")
disabled = true

; Der Auslöser für den Zerfall der Barriere (Block 4). Horcht auf Ebene 1 (Welt)
; und liegt selbst auf keiner Ebene.
;
; monitoring startet AUS. Ein unsichtbarer Area3D wäre trotzdem scharf —
; Sichtbarkeit schaltet keine Bereiche ab. Ohne diese Zeile würde die Barriere
; zerfallen, bevor der Rammbock überhaupt gefunden ist.
[node name="RammbockWirkung" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, -2.18)
collision_layer = 0
collision_mask = 1
monitoring = false
script = ExtResource("8_wirkung")

[node name="Kollision" type="CollisionShape3D" parent="RammbockWirkung"]
shape = SubResource("BoxShape3D_wirkung")

; --- Räder: RayCast3D am oberen Federende, -Z ist vorne -------------------
; Die Reichweite des Raycasts setzt wheel.gd selbst auf Federweg + Reifenradius.
; Das Radmodell hat seine Achse auf der lokalen X-Achse, wie der Controller es
; erwartet — deshalb keine Drehung, nur Skalierung 3,6 auf Radius 0,45.

[node name="RadVorneLinks" type="RayCast3D" parent="." node_paths=PackedStringArray("wheel_node")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 0.52, -1.1)
script = ExtResource("2_rad")
wheel_node = NodePath("Nabe")

[node name="Nabe" type="Node3D" parent="RadVorneLinks"]

[node name="Reifen" parent="RadVorneLinks/Nabe" instance=ExtResource("6_rad_modell")]
transform = Transform3D(3.6, 0, 0, 0, 3.6, 0, 0, 0, 3.6, 0, 0, 0)

[node name="RadVorneRechts" type="RayCast3D" parent="." node_paths=PackedStringArray("wheel_node")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.8, 0.52, -1.1)
script = ExtResource("2_rad")
wheel_node = NodePath("Nabe")

[node name="Nabe" type="Node3D" parent="RadVorneRechts"]

[node name="Reifen" parent="RadVorneRechts/Nabe" instance=ExtResource("6_rad_modell")]
transform = Transform3D(3.6, 0, 0, 0, 3.6, 0, 0, 0, 3.6, 0, 0, 0)

[node name="RadHintenLinks" type="RayCast3D" parent="." node_paths=PackedStringArray("wheel_node")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 0.52, 1.1)
script = ExtResource("2_rad")
wheel_node = NodePath("Nabe")

[node name="Nabe" type="Node3D" parent="RadHintenLinks"]

[node name="Reifen" parent="RadHintenLinks/Nabe" instance=ExtResource("6_rad_modell")]
transform = Transform3D(3.6, 0, 0, 0, 3.6, 0, 0, 0, 3.6, 0, 0, 0)

[node name="RadHintenRechts" type="RayCast3D" parent="." node_paths=PackedStringArray("wheel_node")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.8, 0.52, 1.1)
script = ExtResource("2_rad")
wheel_node = NodePath("Nabe")

[node name="Nabe" type="Node3D" parent="RadHintenRechts"]

[node name="Reifen" parent="RadHintenRechts/Nabe" instance=ExtResource("6_rad_modell")]
transform = Transform3D(3.6, 0, 0, 0, 3.6, 0, 0, 0, 3.6, 0, 0, 0)

; --- Kamera und Ton ------------------------------------------------------

[node name="Kamerarig" parent="." node_paths=PackedStringArray("ziel") instance=ExtResource("3_kamera")]
ziel = NodePath("..")

[node name="Motorton" parent="." node_paths=PackedStringArray("vehicle") instance=ExtResource("4_motorton")]
max_db = -20.0
vehicle = NodePath("..")

[editable path="Karosserie"]
