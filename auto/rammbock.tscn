[gd_scene load_steps=4 format=3]

; ---------------------------------------------------------------------------
; RAMMBOCK — die Geometrie des ersten Traversal-Teils, einmal definiert.
;
; Diese Szene wird an ZWEI Stellen benutzt:
;   auto/spielzeugauto.tscn   montiert an der Front, anfangs unsichtbar
;   welt/fundstueck.tscn      liegt in der Kiste herum, wartet
;
; Dass beides exakt gleich aussieht, ist nicht Bequemlichkeit, sondern der
; ganze Hinweis: "Aufsammeln ist Einbauen" liest sich nur, wenn das Ding am
; Boden erkennbar dasselbe ist wie das Ding an der Stoßstange. Zwei Kopien
; würden früher oder später auseinanderlaufen.
;
; Godot-Primitive, kein eigenes 3D-Modell (CLAUDE.md: kein Blender).
;
; Der Ursprung liegt in der Mitte des Balkens, damit die Szene an beiden Stellen
; frei platziert werden kann. Die Kollisionsform am Auto sitzt separat als
; direktes Kind des RigidBody3D und deckt genau den Balken ab.
; ---------------------------------------------------------------------------

[sub_resource type="StandardMaterial3D" id="Mat_rammbock"]
albedo_color = Color(0.42, 0.44, 0.48, 1)
metallic = 0.8
metallic_specular = 0.7
roughness = 0.35

[sub_resource type="BoxMesh" id="Mesh_balken"]
material = SubResource("Mat_rammbock")
size = Vector3(2.2, 0.55, 0.35)

[sub_resource type="BoxMesh" id="Mesh_strebe"]
material = SubResource("Mat_rammbock")
size = Vector3(0.25, 0.4, 0.5)

[node name="Rammbock" type="Node3D"]

[node name="Balken" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_balken")

[node name="StrebeLinks" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.7, 0, 0.3)
mesh = SubResource("Mesh_strebe")

[node name="StrebeRechts" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.7, 0, 0.3)
mesh = SubResource("Mesh_strebe")
