[gd_scene load_steps=17 format=3]

; ---------------------------------------------------------------------------
; TESTKISTE — Hauptszene. Das ist die Abnahmeszene für Slice 0.
;
; Abnahmekriterium (nur Fabian kann es feststellen):
;   Zehn Minuten ziellos herumfahren, ohne einen Parameter anzufassen,
;   macht Spaß. Zuckt die Hand zum Inspector statt zur Lenkung: nicht bestanden.
;
; Hier wird nichts gemessen. Gemessen wird in welt/testparcours.tscn.
;
; Tasten: W/S oder Hoch/Runter = Gas/Bremse, A/D oder Links/Rechts = Lenken,
;         Leertaste = Handbremse, T = Getriebe auto/manuell, F/R = Gang,
;         ~ = Debug-Overlay, < / > = Debug-Seite wechseln.
; ---------------------------------------------------------------------------

[ext_resource type="PackedScene" path="res://welt/kiste.tscn" id="1_kiste"]
[ext_resource type="Script" path="res://addons/gevp/scripts/vehicle_controllergd.gd" id="2_steuerung"]
[ext_resource type="PackedScene" path="res://auto/spielzeugauto.tscn" id="3_auto"]
[ext_resource type="Script" path="res://addons/gevp/scripts/gui.gd" id="4_anzeige"]
[ext_resource type="Script" path="res://addons/gevp/scripts/debug.gd" id="5_debug"]
[ext_resource type="Script" path="res://addons/gevp/scripts/debug_ui.gd" id="6_debug_ui"]

[sub_resource type="StandardMaterial3D" id="Mat_holz"]
