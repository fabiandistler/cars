[gd_scene load_steps=4 format=3]

; ---------------------------------------------------------------------------
; BARRIERE — das Schloss von Slice 1. Block 1.
;
; Eine Trennwand quer durch die Kiste bei z = -60. Sie ist das Gate: eine
; sichtbare Grenze, die genau ein Teil aufhebt (der Rammbock, Block 2-4). Bis
; dahin prallt das Auto ab, jedes Mal.
;
; WARUM 2,4 EINHEITEN HOCH
; Die Höhe löst den Zielkonflikt aus SLICE1.md: "niedrig genug zum Drübersehen,
; zu hoch zum Drüberfahren". Beide Hälften hängen an Zahlen, die vorher nicht
; gemessen waren (Godot 4.7.2 headless, 27.08.2026):
;
;   Auto ruht bei y = 0.07
;   Dachkante                          = 2,435  (Kenney-Truck, seit Block 0)
;   Kamera-Auge im Stand               = 2,37
;   Kamera-Auge bei Tempo              = 2,98   (Federarm 7,5 -> 11, 10° Neigung)
;
; 2,4 liegt über dem Auge im Stand, aber unter dem Auge bei Tempo.
;
; ZUM DACH: Als diese Wand gebaut wurde, fuhr noch die Platzhalterkarosserie,
; 1,84 hoch — die Wand stand sichtbar darüber. Der Truck aus Block 0 ist 2,435
; hoch, die Wand liegt also 0,035 UNTER seiner Dachkante, praktisch auf einer
; Linie. Das ist keine Fehlfunktion: "zu hoch zum Drüberfahren" gilt unverändert
; (senkrechte Fläche, Reifenradius 0,45), und die Kamera hängt am Wurzelknoten,
; nicht an der Karosserie, liegt bei Tempo also weiterhin 0,58 über der
; Oberkante. Die Sichtlinie ist unberührt.
;
;   => Offen bleibt, ob eine Wand auf exakt Dachhöhe als Schloss lesbar ist
;      oder ob sie 0,3 bis 0,5 höher gehört. Das ist eine Frage ans Auge und
;      gehört zu Block 5 — ein Agent kann sie nicht beantworten.
;
; Was das für die Sichtlinie GENAU heißt, gerechnet statt behauptet: bei Tempo
; liegt das Auge 0,58 über der Oberkante. Der verdeckte Bodenstreifen hinter
; der Wand ist damit rund 2,4/0,58 = 4,1 mal der Abstand Kamera-Wand — aus
; typischer Anfahrt (Auto 20 Einheiten vor der Wand, Kamera 10 dahinter) also
; etwa 124 Einheiten. Hinter der Wand liegen nur 142 Einheiten. Vom BODEN
; dahinter sieht man im Anfahren also praktisch nichts.
;
;   => Sichtbar ist nur, was die Linie y = 2,4 überragt. Ob das ausreicht,
;      damit man ahnt, dass dahinter etwas ist, kann nur Fabian beim Fahren
;      feststellen — ein Agent kann nicht fahren und nicht sehen.
;   => BLOCK 5: Der Köder hinter der Wand muss über y = 2,4 hinausragen. Etwas,
;      das flach auf dem Boden liegt, ist aus der Anfahrt unsichtbar.
;   => Wer abstand_tempo, die Neigung des Federarms oder die Autohöhe ändert,
;      ändert diese Wand mit. Die Kamera ist hier ein Bauteil, keine Optik.
;
; WARUM DIE WAND NICHT ÜBERSPRUNGEN WERDEN KANN
; Die Höhe allein macht kein dichtes Gate — ein Auto mit genug Anlauf kommt
; über fast alles, und ein Gate, das mit Geduld knackbar ist, ist eine
; Ermutigung zum Exploit. Dicht wird die Wand durch die GEOMETRIE der Anfahrt:
; das einzige Sprunggerät der Kiste ist die Rampe bei z = -95. Die liegt
; HINTER dieser Wand und ist ein StaticBody3D, lässt sich also nicht
; davorschieben. Auf der Startseite gibt es keine Auffahrt — die Würfel und
; Klötze dort sind senkrechte Kästen, und der Reifenradius von 0,45 begrenzt
; die Stufe, die ein Rad nehmen kann.
;
;   => Wer die Wand nach Norden verschiebt (z < -95), macht die Rampe zur
;      Abkürzung und das Gate wertlos.
;
; GEMESSEN, NICHT VERMUTET
; Sieben Vollgas-Anläufe headless, je frische Szene: frontal mit langem und
; kurzem Anlauf, 20° schräg von beiden Seiten, dicht an West- und Ostwand,
; und 8° schräg. Höchsttempo 41 Einheiten/s. Ergebnis: 0 Durchbrüche, das Auto
; kommt nie weiter als z = -56,1 (Südflanke der Wand liegt bei z = -58) und
; hebt dabei nicht ab (größte Höhe 0,17).
;
; Nach dem Karosserietausch in Block 0 drei Läufe wiederholt: Zahlen auf die
; zweite Nachkommastelle identisch. Erwartbar — der Kollisionskörper wurde nicht
; angefasst, getauscht wurde nur, was man sieht.
;
; WARUM RIGIDBODY3D UND NICHT STATICBODY3D
; Die Klötze sind eingefrorene RigidBody3D: freeze = true, freeze_mode bleibt
; auf dem Standard FREEZE_MODE_STATIC (= 0, gegen Godot 4.7.2 geprüft). So
; verhalten sie sich exakt wie StaticBody3D — nichts lässt sich wegschieben,
; egal mit wieviel Anlauf.
;
; Godot kann die Klasse eines Knotens zur Laufzeit nicht wechseln. Der Zerfall
; in Block 4 ist deshalb "freeze = false" auf den getroffenen Klötzen — eine
; Zeile statt eines Neubaus.
;
;   => Deshalb darf KEIN Klotz einen anderen Körper durchdringen, solange er
;      eingefroren ist. Eine Durchdringung fällt eingefroren nicht auf und
;      schleudert den Klotz beim Auftauen heraus. Die Wand endet daher bündig
;      an den Innenflächen der Seitenwände (±200), sie steckt NICHT darin.
;
; GRUPPE "Road": erste Gruppe jedes Klotzes. wheel.gd liest die erste Gruppe
; des getroffenen Colliders und schlägt damit Reifenwerte nach; fehlt sie,
; läuft der Controller in einen Dictionary-Fehler. Gilt vor UND nach dem
; Zerfall.
;
; KOLLISIONSEBENE 1 (Welt), nicht 2. Sonst hängt der SpringArm3D der Kamera an
; der Wand fest, sobald das Auto davorsteht.
;
; MASSE 60 je Klotz gegen 1500 des Autos: eingefroren ohne Wirkung, beim
; Zerfall fliegen sie weg statt zu bremsen.
; ---------------------------------------------------------------------------

[sub_resource type="StandardMaterial3D" id="Mat_barriere"]
albedo_color = Color(0.72, 0.58, 0.2, 1)
roughness = 0.75

[sub_resource type="BoxShape3D" id="BoxShape3D_klotz"]
size = Vector3(8, 2.4, 4)

[sub_resource type="BoxMesh" id="Mesh_klotz"]
material = SubResource("Mat_barriere")
size = Vector3(8, 2.4, 4)

[node name="Barriere" type="Node3D"]

; 50 Klötze à 8 Einheiten, Mittelpunkte x = -196 bis +196. Die Wand spannt
; damit genau -200 bis +200 und liegt bündig an den Innenflächen der
; Seitenwände: kein Spalt an den Rändern und keine Durchdringung.

